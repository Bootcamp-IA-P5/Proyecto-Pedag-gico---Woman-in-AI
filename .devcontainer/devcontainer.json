{
    "name": "vertice-factoriaf5",

    "build": {
        "context": "..",
        "dockerfile": "Dockerfile.dev"
    },

    "remoteUser": "root",

    "containerEnv": {
        "UV_SYSTEM_PYTHON": "1",
        "UV_NO_CACHE": "1",
        "UV_NO_ENV_FILE": "1",
        "UV_PROJECT_ENVIRONMENT": "/usr/local"
    },

    "postCreateCommand": "uv sync --python /usr/local/bin/python3 --project backend && npm --prefix frontend install",
"postStartCommand": "chmod 666 /var/run/docker.sock && export PYTHONPATH=$PYTHONPATH:$(pwd)/backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 & npm --prefix frontend run dev -- --host 0.0.0.0 --port 5173",
    "mounts": [
        "source=uv-cache,target=/home/vscode/.cache/uv,type=volume",
        "source=npm-cache,target=/home/vscode/.npm,type=volume",
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "github.copilot",
                "charliermarsh.ruff",
                "dsznajder.es7-react-js-snippets",
                "esbenp.prettier-vscode",
                "bradlc.vscode-tailwindcss",
                "ms-vscode.vscode-typescript-next"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python3",
                "python.analysis.extraPaths": ["./backend"],
                "python.terminal.activateEnvironment": false
            }
        }
    }
}