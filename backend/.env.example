# ============================================================================
# VERTICE API - environment variables para deployment en Digital Ocean
# ============================================================================
# Copiar este archivo a .env y completar con tus valores reales
# NO hacer commit de .env con valores secretos
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# SUPABASE - Base de datos y persistencia
# ─────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ─────────────────────────────────────────────────────────────────────────
# LLM PROVIDERS - APIs de modelos de lenguaje
# ─────────────────────────────────────────────────────────────────────────

# Groq (rápido, recomendado para producción)
GROQ_API_KEY=
GROQ_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Mistral
MISTRAL_API_KEY=
MISTRAL_KEY=
MISTRAL_MODEL=mistral-small-latest

# Together.ai
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-405B-Instruct-Turbo

# GitHub Models (usa GITHUB_TOKEN)
GITHUB_MODELS_KEY=
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=deepseek-r1

# OpenRouter (fallback)
OPENROUTER_API_KEY=
OPEN_ROUTER_MODEL=openrouter/auto

# Compatible LLM (custom endpoint)
COMPAT_LLM_URL=
COMPAT_LLM_KEY=
COMPAT_LLM_MODEL=

# Orden de fallback de proveedores (separados por coma)
# groq,gemini,mistral,github,openrouter,together,compat
LLM_PROVIDER_ORDER=groq,gemini,mistral,github,openrouter,together,compat

# ─────────────────────────────────────────────────────────────────────────
# SPOTIFY - Para scrapeo de canciones
# ─────────────────────────────────────────────────────────────────────────
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# MUSICBRAINZ - Metadata de canciones
# ─────────────────────────────────────────────────────────────────────────
MUSICBRAINZ_EMAIL=

# ─────────────────────────────────────────────────────────────────────────
# ANALYSIS PIPELINE - Configuración del análisis
# ─────────────────────────────────────────────────────────────────────────

# Timeout total para análisis de canción (segundos)
LLM_TIMEOUT_SECONDS=25

# Número máximo de reintentos con fallback
LLM_MAX_RETRIES=3

# Base para retry backoff exponencial
LLM_RETRY_BASE=2.0

# Modo guardian: "true" = falla si hay violación; "false" = permite análisis con warning
ANALYSIS_GUARDIAN_STRICT=false

# Modo pipeline: "simple" o "two-stage"
ANALYSIS_PIPELINE_MODE=simple

# Cobertura mínima para análisis conclusivo (0.0-1.0)
ANALYSIS_MIN_COVERAGE_FOR_CONCLUSIVE=0.75

# ─────────────────────────────────────────────────────────────────────────
# SERVER - Configuración del servidor
# ─────────────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# CORS allowed origins (separadas por comas para producción)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
