FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim

RUN apt-get update && apt-get install -y \
    curl \
    git \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m vscode

# Fix permisos Python
RUN chown -R vscode:vscode /usr/local/lib/python3.11/site-packages/ \
    && chown -R vscode:vscode /usr/local/bin/

# Fix permisos npm — esto soluciona el EACCES
RUN mkdir -p /home/vscode/.npm \
    && chown -R vscode:vscode /home/vscode/.npm

WORKDIR /app

RUN chown -R vscode:vscode /app

ENV UV_SYSTEM_PYTHON=1
ENV UV_NO_CACHE=1
ENV UV_NO_ENV_FILE=1
ENV UV_PROJECT_ENVIRONMENT=/usr/local